interface recipe {
    use item-stack.{item-stack};

    /// Recipe category for the recipe book.
    enum recipe-category {
        building,
        redstone,
        equipment,
        misc,
        food,
        blocks,
    }

    /// Represents an ingredient in a recipe.
    variant ingredient {
        /// A specific item (e.g. "minecraft:diamond").
        item(string),
        /// A tag group of items (e.g., "minecraft:logs").
        tag(string),
        /// One of multiple specific items.
        one-of(list<string>),
    }

    /// Represents a shaped crafting recipe.
    record shaped-recipe {
        /// The pattern of the recipe (e.g., ["# #", " s ", "# #"]).
        pattern: list<string>,
        /// Mapping of characters in the pattern to ingredients.
        key: list<tuple<string, ingredient>>,
        /// The resulting item stack.
        output: item-stack,
        /// The recipe group (optional).
        group: option<string>,
        /// The recipe category in the recipe book.
        category: option<recipe-category>,
        /// Whether to show a toast notification when the recipe is unlocked.
        show-notification: option<bool>,
    }

    /// Represents a shapeless crafting recipe.
    record shapeless-recipe {
        /// The list of ingredients required.
        ingredients: list<ingredient>,
        /// The resulting item stack.
        output: item-stack,
        /// The recipe group (optional).
        group: option<string>,
        /// The recipe category in the recipe book.
        category: option<recipe-category>,
    }

    /// Represents a cooking recipe (Smelting, Blasting, Smoking, Campfire).
    record cooking-recipe {
        /// The ingredient to cook.
        ingredient: ingredient,
        /// The resulting item stack.
        output: item-stack,
        /// Experience points awarded.
        experience: f32,
        /// Cooking time in ticks.
        cooking-time: u32,
        /// The recipe group (optional).
        group: option<string>,
        /// The recipe category in the recipe book.
        category: option<recipe-category>,
    }

    /// Types of cooking stations.
    enum cooking-type {
        smelting,
        blasting,
        smoking,
        campfire,
    }

    /// A crafting recipe the server has, as `recipe-manager.crafting-recipes-for` lists it.
    record crafting-recipe-info {
        /// True for a shaped recipe, false for a shapeless one.
        shaped: bool,
        /// A shaped recipe's pattern size (at most 3 by 3); 0 for a shapeless one.
        width: u32,
        height: u32,
        /// A shaped recipe's cells row by row (`width` per row), `none` for an empty one; a
        /// shapeless recipe's ingredients. Each lists the item ids it accepts, tags resolved.
        ingredients: list<option<list<string>>>,
        /// The result item id (`minecraft:iron_block`).
        output: string,
        /// How many the recipe makes.
        output-count: u8,
    }

    /// Common interface for registering recipes.
    resource recipe-manager {
        /// Registers a shaped crafting recipe.
        register-shaped: func(id: string, recipe: shaped-recipe);
        
        /// Registers a shapeless crafting recipe.
        register-shapeless: func(id: string, recipe: shapeless-recipe);

        /// Registers a cooking recipe.
        register-cooking: func(id: string, station-type: cooking-type, recipe: cooking-recipe);

        /// The result of crafting `grid` (row by row, `width` slots per row, at most 3 by 3), as a
        /// crafting table would give it: vanilla, datapack, mod and plugin recipes. Like Fabric's
        /// `RecipeManager.getRecipeFor(RecipeType.CRAFTING, ...)`.
        match-crafting: func(width: u32, grid: list<option<borrow<item-stack>>>) -> option<item-stack>;

        /// The crafting recipes (vanilla, datapack, mod and plugin) whose result is `item` (an id,
        /// `minecraft:` optional), with their shapes and ingredients. Like Fabric's
        /// `RecipeManager.recipes.byType(RecipeType.CRAFTING)` filtered by result. Special
        /// recipes whose result depends on the grid (a plugin's crafting handler, decorated pots)
        /// are not listed.
        crafting-recipes-for: func(item: string) -> list<crafting-recipe-info>;

        /// The result of cooking `input` at a station, as a furnace, blast furnace, smoker or
        /// campfire would give it.
        match-cooking: func(station-type: cooking-type, input: borrow<item-stack>) -> option<item-stack>;
    }
}

