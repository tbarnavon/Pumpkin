/// Behaviour and storage for content that mods add: blocks with custom interaction, custom drops,
/// and block entities whose data the plugin owns.
///
/// A plugin registers hooks for a set of block names with `context.register-block-hooks`; the host
/// then calls the plugin's `handle-block-hook` export at the matching points of the block's life,
/// the same points where vanilla calls the corresponding `Block` methods.
interface modded {
    use common.{block-pos, position, nbt-tree, hand};
    use %world.{%world, block-direction};
    use player.{player};
    use item-stack.{item-stack};
    use menu.{menu-definition};

    /// The hooks a plugin implements for a set of blocks.
    flags block-hooks {
        /// `Block.getStateForPlacement`: choose the state to place.
        placement-state,
        /// `Block.setPlacedBy`: called once the block is in the world.
        placed,
        /// `Block.useItemOn` / `useWithoutItem`: right click.
        %use,
        /// `Block.attack`: left click start. A non-`pass` result stops a creative player from
        /// breaking the block (Fabric's `AttackBlockCallback` semantics).
        attack,
        /// `Block.getDrops`: the items dropped when broken, replacing the loot table.
        drops,
        /// `BlockEntity.preRemoveSideEffects`: the block is about to be removed or replaced.
        removed,
        /// `Block.tick`: a tick scheduled with `world.schedule-block-tick` fired.
        scheduled-tick,
        /// `Block.neighborChanged`: a block next to this one changed.
        neighbor-changed,
        /// `Block.randomTick`: only for states the mod marks as randomly ticking.
        random-tick,
        /// `Block.updateShape`: a neighbour's state changed; reply with the state this block
        /// should take, or `none` to keep it.
        update-shape,
        /// `Block.isSignalSource`: the block gives the redstone power set with
        /// `world.set-redstone-output`. No call is made.
        signal-source,
        /// `Block.hasAnalogOutputSignal`: comparators read the value set with
        /// `world.set-comparator-output`. No call is made.
        analog-output,
        /// `Block.entityInside`: every tick an entity's box is inside the block. Opt in only
        /// for blocks that need it; it is called every tick.
        entity-inside,
        /// `Block.stepOn`: every tick an entity walks on top of the block. Opt in only for
        /// blocks that need it; it is called every tick.
        step-on,
        /// A block entity ticker (`EntityBlock.getTicker`): every tick for each block of this
        /// kind that has block-entity data, in chunks that tick. Opt in only for blocks that
        /// need it; it is called every tick.
        ticker,
    }

    /// Where a player's crosshair hit the block.
    record block-hit {
        pos: block-pos,
        face: block-direction,
        /// Exact hit point in world coordinates.
        location: position,
    }

    record placement {
        %world: %world,
        pos: block-pos,
        /// The state the host would place (the block's default state).
        state: u16,
        player: option<player>,
        hit: block-hit,
        /// `BlockPlaceContext.getHorizontalDirection()`: the direction the player faces.
        horizontal-facing: block-direction,
        /// The stack the block is placed from.
        item: option<item-stack>,
    }

    record interaction {
        %world: %world,
        pos: block-pos,
        state: u16,
        player: player,
        hand: hand,
        hit: block-hit,
    }

    record breaking {
        %world: %world,
        pos: block-pos,
        state: u16,
        player: option<player>,
        /// The item used to break the block.
        tool: option<item-stack>,
    }

    record removal {
        %world: %world,
        pos: block-pos,
        /// The state being removed.
        state: u16,
    }

    record tick {
        %world: %world,
        pos: block-pos,
        state: u16,
    }

    record entity-contact {
        %world: %world,
        pos: block-pos,
        state: u16,
        entity-id: s32,
        /// Like `minecraft:zombie`.
        entity-type: string,
    }

    record shape-update {
        %world: %world,
        pos: block-pos,
        state: u16,
        /// The side the changed neighbour is on.
        direction: block-direction,
        neighbor-pos: block-pos,
        neighbor-state: u16,
    }

    record neighbor-change {
        %world: %world,
        pos: block-pos,
        state: u16,
        /// The block that changed next to this one, like `minecraft:redstone_wire`.
        source-block: string,
    }

    variant block-call {
        placement-state(placement),
        placed(placement),
        %use(interaction),
        attack(interaction),
        drops(breaking),
        removed(removal),
        scheduled-tick(tick),
        neighbor-changed(neighbor-change),
        random-tick(tick),
        update-shape(shape-update),
        entity-inside(entity-contact),
        step-on(entity-contact),
        block-entity-tick(tick),
    }

    /// `InteractionResult`.
    enum interaction-result {
        pass,
        success,
        consume,
        fail,
    }

    variant block-reply {
        /// For calls without a result, or to keep the host's default.
        none,
        /// Reply to `placement-state`: the state to place.
        state(u16),
        /// Reply to `use` and `attack`.
        interaction(interaction-result),
        /// Reply to `drops`.
        drops(list<item-stack>),
    }

    /// The hooks a plugin implements for a set of items.
    flags item-hooks {
        /// `Item.useOn`: right click on a block, after the block's own `use` passed.
        use-on-block,
        /// `Item.use`: right click in the air.
        %use,
        /// `Item.inventoryTick`: every tick for each stack of the item in a player's
        /// inventory. Opt in only for items that need it; it is called every tick.
        inventory-tick,
    }

    record item-use-on-block {
        %world: %world,
        pos: block-pos,
        /// State of the clicked block.
        state: u16,
        player: player,
        hand: hand,
        hit: block-hit,
        /// A copy of the used stack. Change the player's hand through the player API.
        stack: item-stack,
    }

    record item-use {
        %world: %world,
        player: player,
        hand: hand,
        /// A copy of the used stack. Change the player's hand through the player API.
        stack: item-stack,
    }

    record item-inventory-tick {
        %world: %world,
        player: player,
        /// Inventory slot: 0-8 hotbar, 9-35 main, 36-39 armor, 40 offhand.
        slot: u32,
        /// Whether the slot is the selected hotbar slot.
        selected: bool,
        /// A copy of the stack. Change it through the player's inventory.
        stack: item-stack,
    }

    variant item-call {
        use-on-block(item-use-on-block),
        %use(item-use),
        inventory-tick(item-inventory-tick),
    }

    /// Opens a menu of a modded menu type, like Fabric's `ExtendedMenuProvider`: the client gets
    /// `fabric-menu-api-v1:open_screen` with the type, the title and `data`, the bytes the menu
    /// type's stream codec reads.
    open-menu: func(player: borrow<player>, handler-id: u32, menu-type: string, data: list<u8>, menu: menu-definition) -> result<_, string>;

    /// One node of a modded component type's stream codec. Nodes refer to their children by index
    /// in the list given to `register-component-stream-codec`; the root is node 0. Each node says
    /// how a part of the stored value (the NBT the type's persistent codec writes) goes on the
    /// network.
    variant stream-codec-node {
        /// `ByteBufCodecs.BOOL`; NBT byte 0 or 1.
        %bool,
        /// `ByteBufCodecs.BYTE`.
        byte,
        /// `ByteBufCodecs.SHORT`.
        short,
        /// `ByteBufCodecs.INT`.
        int,
        /// `ByteBufCodecs.LONG`.
        long,
        /// `ByteBufCodecs.FLOAT`.
        float,
        /// `ByteBufCodecs.DOUBLE`.
        double,
        /// `ByteBufCodecs.VAR_INT`; NBT int.
        var-int,
        /// `ByteBufCodecs.VAR_LONG`; NBT long.
        var-long,
        /// `ByteBufCodecs.STRING_UTF8`.
        %string,
        /// `ByteBufCodecs.TAG`: any NBT value as a network NBT tag.
        nbt,
        /// `ItemStack.STREAM_CODEC`; NBT as `ItemStack.CODEC`.
        item-stack,
        /// `ItemStack.OPTIONAL_STREAM_CODEC`; NBT as `ItemStack.OPTIONAL_CODEC` (`{}` when empty).
        optional-item-stack,
        /// `UUIDUtil.STREAM_CODEC`; NBT int array of 4.
        uuid,
        /// `BlockPos.STREAM_CODEC`; NBT int array of 3.
        block-pos,
        /// `StreamCodec.composite`: an NBT compound, written field by field in this order, each
        /// as (NBT key, node index).
        composite(list<tuple<string, u32>>),
        /// `ByteBufCodecs.list()`: an NBT list of the node.
        %list(u32),
        /// `ByteBufCodecs.optional()`: a bool, then the node when present. As a composite field,
        /// an absent key is empty.
        optional(u32),
    }

    /// Gives a modded component type (like `storagedrawers:frame_data`) its stream codec, for types
    /// registered with `networkSynchronized(...)`. Without one, the host sends the value as a
    /// network NBT tag, vanilla's default stream codec. Replaces an earlier codec for the type.
    register-component-stream-codec: func(component: string, nodes: list<stream-codec-node>) -> result<_, string>;
}
