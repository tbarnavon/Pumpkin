/// The main entry point for a Pumpkin plugin.
/// This world defines the exports that the plugin must provide to the host
/// and the imports that the host provides to the plugin.
package pumpkin:plugin@0.2.0;

world plugin {
    use context.{context};
    use event.{event};
    use server.{server as server-instance};
    use command.{command-sender, consumed-args, command-error, command-suggestions, suggestion-request};
    use %world.{entity, chunk-buffer, generation-phase};
    use ipc.{plugin-id, ipc-message};
    use modded.{block-call, block-reply, item-call, tick-batch};
    use menu.{menu-call, menu-reply};
    use player.{player as player-instance};
    use item-stack.{item-stack};

    // --- Host-provided imports ---

    /// Provides logging capabilities to the plugin.
    import logging;
    /// Provides GUI creation and management.
    import gui;
    /// Provides scoreboard management.
    import scoreboard;
    /// Provides global server information and player lookup.
    import server;
    /// Provides text component building and formatting.
    import text;
    /// Provides command registration and argument parsing.
    import command;
    /// Provides the plugin execution context.
    import context;
    /// Provides internationalization and translation support.
    import i18n;
    /// Provides task scheduling for delayed or repeating logic.
    import scheduler;
    /// Provides world information and block manipulation.
    import %world;
    /// Provides entity types and manipulation.
    import entity;
    /// Provides boss bar creation and management.
    import boss-bar;
    /// Provides Bedrock custom forms.
    import forms;
    /// Provides Java Edition dialogs.
    import java-dialogs;
    /// Provides status effect types and instances.
    import status-effect;
    /// Provides block entity types and instances.
    import block-entity;
    /// Provides 1 : 1 inter-plugin communication
    import ipc;
    /// Provides entity attribute types and modifiers.
    import attributes;
    /// Provides player management.
    import player;
    /// Provides advancement definitions and progress types.
    import advancement;
    /// Provides custom recipe registration and management.
    import recipe;
    /// Provides inventory manipulation and management.
    import inventory;
    /// Provides datapack inspection and management.
    import datapack;
    /// Provides custom enchantment registration and management.
    import enchantments;
    /// Provides damage types.
    import damage-types;
    /// Provides screen / window types for GUIs and containers.
    import screens;
    /// Provides player statistics categories and types.
    import statistics;
    /// Provides Display and Interaction entities.
    import display;
    /// Provides game rules definitions and queries.
    import game-rules;
    /// Provides game event types.
    import game-events;
    /// Provides potion types.
    import potions;
    /// Provides entity status / animation event types.
    import entity-statuses;
    /// Provides behaviour hooks and block-entity storage for modded content.
    import modded;
    /// Provides menus whose slots the plugin defines.
    import menu;

    // --- Plugin-provided exports ---

    /// Called by the host once to initialize the plugin.
    /// Internal use only; plugins should use the `register_plugin!` macro.
    export init-plugin: func();

    /// Called when the plugin is being loaded.
    /// Use this to register commands, events, and perform initial setup.
    export on-load: func(context: context) -> result<_, string>;

    /// Called when the plugin is being unloaded.
    /// Use this to save data and clean up resources.
    export on-unload: func(context: context) -> result<_, string>;

    /// Provides plugin metadata (name, version, etc.) to the host.
    export metadata;

    /// Dispatches an event to the plugin for handling.
    export handle-event: func(event-id: u32, server: server-instance, event: event) -> event;

    /// Dispatches a command execution to the plugin.
    export handle-command: func(command-id: u32, sender: command-sender, server: server-instance, args: consumed-args) -> result<s32, command-error>;

    /// Dispatches a command suggestion request to the plugin.
    export handle-command-suggestion: func(handler-id: u32, sender: command-sender, server: server-instance, request: suggestion-request) -> command-suggestions;

    /// Dispatches a scheduled task execution to the plugin.
    export handle-task: func(handler-id: u32, server: server-instance);

    /// Dispatches a block hook registered with `context.register-block-hooks`.
    export handle-block-hook: func(handler-id: u32, server: server-instance, call: block-call) -> block-reply;

    /// Dispatches an item hook registered with `context.register-item-hooks`. Only the
    /// `interaction` and `none` replies are meaningful.
    export handle-item-hook: func(handler-id: u32, server: server-instance, call: item-call) -> block-reply;

    /// Runs a plugin's per-tick block and item hooks for one world, once per tick, when there
    /// is at least one.
    export handle-tick-batch: func(server: server-instance, batch: tick-batch);

    /// Runs a job started with `scheduler.spawn-job`. Called on a worker instance, never on the
    /// main one.
    export run-job: func(kind: u32, input: list<u8>) -> result<list<u8>, string>;

    /// Receives the output of the job `job-id` started with `scheduler.spawn-job`.
    export handle-job-result: func(job-id: u64, server: server-instance, output: result<list<u8>, string>);

    /// Answers a crafting grid for a handler registered with `context.register-crafting-handler`:
    /// the result, or none when the grid is not this handler's recipe. `grid` is row by row,
    /// `width` slots per row.
    export handle-crafting: func(handler-id: u32, width: u32, grid: list<option<item-stack>>) -> option<item-stack>;

    /// Answers a call about a menu opened with `menu.open` or `modded.open-menu`.
    export handle-menu-call: func(handler-id: u32, menu-id: u32, player: player-instance, call: menu-call) -> menu-reply;

    /// Processes an incoming message from another plugin if possible, and returns (a possibly empty) response.
    export handle-ipc-message: func(sender: plugin-id, message: ipc-message) -> result<ipc-message, string>;

    export handle-ai-goal-can-start: func(goal-id: u32, server: server-instance, entity: entity) -> bool;
    export handle-ai-goal-should-continue: func(goal-id: u32, server: server-instance, entity: entity) -> bool;
    export handle-ai-goal-start: func(goal-id: u32, server: server-instance, entity: entity);
    export handle-ai-goal-tick: func(goal-id: u32, server: server-instance, entity: entity);
    export handle-ai-goal-stop: func(goal-id: u32, server: server-instance, entity: entity);

    /// Dispatches a chunk generation phase to the plugin.
    export handle-generate-phase: func(generator-id: u32, phase: generation-phase, chunk: chunk-buffer);
}
